{
	"name": "@biocontext/repo",
	"author": "Zoheb Khan",
	"version": "0.1.0",
	"private": true,
	"description": "macOS terminal UI that answers Bioconductor package questions from local documentation and exact source, with file, line-range, and package-version citations",
	"repository": {
		"type": "git",
		"url": "https://github.com/ZohebKhan1/biocontext"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"keywords": [
		"cli",
		"ai",
		"bioconductor",
		"bioinformatics",
		"tui",
		"macos"
	],
	"engines": {
		"bun": ">=1.1.0"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"tui": "bun run apps/tui/src/index.ts",
		"dev:tui": "bun run --watch apps/tui/src/index.ts",
		"build": "turbo build --filter=biocontext",
		"check:all": "bun run check:root && turbo check",
		"check:root": "tsgo --noEmit",
		"check:tui": "turbo check --filter=biocontext",
		"check:engine": "turbo check --filter=@biocontext/engine",
		"check:shared": "turbo check --filter=@biocontext/shared",
		"format:all": "turbo format",
		"test:all": "turbo test",
		"test:engine": "turbo test --filter=@biocontext/engine",
		"sync:bioconductor-docs": "bun run scripts/sync-bioconductor-docs.ts",
		"clean": "find . -type d \\( -name node_modules -o -name .turbo \\) -prune -exec rm -rf {} +"
	},
	"devDependencies": {
		"@types/bun": "^1.3.10",
		"@typescript/native-preview": "^7.0.0-dev.20260305.1",
		"marked": "17.0.1",
		"prettier": "^3.8.1",
		"turbo": "^2.8.13",
		"typescript": "^5.9.3"
	}
}
